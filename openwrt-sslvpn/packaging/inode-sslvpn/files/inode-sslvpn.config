# Template only. Fill gateway, username and trust settings on the target router.
# Keep the real configuration out of Git (e.g. local/inode-sslvpn.config).
config vpn 'main'
	option enabled '0'
	option gateway ''
	option domain 'local'
	option username ''
	option password_file '/etc/inode-sslvpn/password'
	# For a private/self-signed gateway, set an independently confirmed SHA-256 pin.
	option servercert ''
	option ca_file ''
	option gateway_routes '1'
	# Opt-in split DNS. Only DNS servers covered by VPN routes are used.
	option gateway_dns '0'
	# list dns_domain 'internal.example.com'
	# Opt-in LAN forwarding and source NAT through dynamic inode tunnel devices.
	option lan_access '0'
	option reconnect_attempts '5'
	option keepalive '30'
	option mtu '1400'
	# Optional explicit internal networks; do not use a default route.
	# list route '192.0.2.0/24'
