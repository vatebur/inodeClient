#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
	local enabled
	config_load inode-sslvpn
	config_get_bool enabled main enabled 0
	# Recover owned DNS after an unclean process exit or a router reboot.
	/usr/libexec/inode-sslvpn-dns down || return 1
	/usr/libexec/inode-sslvpn-firewall apply || return 1
	[ "$enabled" = 1 ] || return 0
	mkdir -p /var/run/inode-sslvpn
	chmod 700 /var/run/inode-sslvpn
	rm -f /var/run/inode-sslvpn/status /var/run/inode-sslvpn/status.tmp
	procd_open_instance
	procd_set_param command /usr/libexec/inode-sslvpn-run
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 20
	# No respawn: rejected credentials must not cause repeated logins.
	procd_close_instance
}
stop_service() {
	local result=0
	/usr/libexec/inode-sslvpn-dns down || result=1
	/usr/libexec/inode-sslvpn-firewall remove || result=1
	return "$result"
}
service_triggers() {
	procd_add_reload_trigger inode-sslvpn
}
